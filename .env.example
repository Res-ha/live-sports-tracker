# Salin file ini menjadi .env lalu isi nilai Anda.
# DATABASE_URL: SQLite lokal (produksi bisa diganti PostgreSQL).
DATABASE_URL="file:./dev.db"

# Secret untuk JWT session. Generate dengan: npx auth secret (atau string acak panjang).
# Di development boleh kosong (fallback otomatis), WAJIB diisi di production.
AUTH_SECRET=

# API-Football (api-sports.io) — opsional. Jika kosong, aplikasi memakai data mock.
# API key HANYA dipakai server-side.
API_FOOTBALL_KEY=
