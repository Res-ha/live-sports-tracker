# Salin file ini menjadi .env lalu isi nilai Anda.
# API-Football (api-sports.io). Plan Free HANYA mengakses musim 2022-2024.
# Jika kosong, aplikasi memakai data mock sebagai fallback.
API_FOOTBALL_KEY=
# Musim yang dipakai (2022 | 2023 | 2024). Default: musim di src/lib/api/league.ts.
API_FOOTBALL_SEASON=2024
# TTL cache (detik) request API-Football. Plan Free = 100 request/hari,
# jadi data statis di-cache 24 jam. Nilai ini mengontrol endpoint dinamis.
API_FOOTBALL_CACHE_SECONDS=3600
# URL publik untuk canonical, Open Graph, robots, dan sitemap.
NEXT_PUBLIC_SITE_URL=https://live-pl-tracker.pages.dev
