{
  "name": "live-sports-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-static.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "start": "wrangler pages dev out",
    "lint": "eslint",
    "bake": "tsx scripts/bake-data.mts",
    "preview": "npm run build && npm run verify:static && wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name=live-sports-tracker"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.122.0"
  }
}
